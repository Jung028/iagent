"""
rag/service.py

RAG Memory Service — updated to match actual database schema.

Reads from:
  user_info       → profile, contacts (contact_config), status
  user_entities   → learned aliases from conversation
  threads         → conversation sessions
  interactions    → every message turn with vector embedding

Two public methods:
  get_context(user_id, message, thread_id) → dict
      Called BEFORE LLM sees the message.

  store(user_id, thread_id, message, intents, entities, result)
      Called AFTER orchestrator finishes.

Dependencies:
  pip install asyncpg openai redis structlog

Environment variables:
  OPENAI_API_KEY   — for text embeddings
  DATABASE_URL     — asyncpg PostgreSQL connection string
  REDIS_URL        — Redis connection string
"""

from __future__ import annotations

import json
import uuid
from typing import Any

import structlog
from openai import AsyncOpenAI

log = structlog.get_logger(__name__)

EMBEDDING_MODEL = "text-embedding-3-small"
TOP_K_HISTORY   = 5       # how many past interactions to retrieve
SESSION_TTL     = 3600    # Redis session TTL in seconds (1 hour)


class RAGService:
    """RAG Memory Service.

    Registered on app.state once at startup:

        app.state.rag_service = RAGService(pool=db_pool, redis=redis_client)
    """

    def __init__(self, pool, redis) -> None:
        self._pool   = pool
        self._redis  = redis
        self._openai = AsyncOpenAI()

    # ── PUBLIC METHOD 1: get_context ──────────────────────────────────────────

    async def get_context(
        self,
        user_id: int,
        message: str,
        thread_id: str | None = None,
    ) -> dict[str, Any]:
        """Fetch all context for this user + message before LLM sees it.

        Returns:
        {
            "profile":          { user_name, phone_no, status, timezone, currency },
            "contacts":         [ { displayName, phoneNo, userId } ],
            "entities":         { "landlord": { name, walletId }, ... },
            "thread_id":        "abc-123",
            "recent_messages":  [ { role, content, created_at } ],
            "relevant_history": [ { message, intents, result } ],
            "session":          { ... }
        }
        """
        log.info("rag.get_context.start", user_id=user_id, thread_id=thread_id)

        import asyncio

        # resolve or create thread first — other fetches depend on thread_id
        thread_id = await self._resolve_thread(user_id, thread_id)

        # run all fetches concurrently — they hit different tables
        profile, entities, recent_messages, relevant_history, session = (
            await asyncio.gather(
                self._fetch_profile(user_id),
                self._fetch_entities(user_id),
                self._fetch_recent_messages(thread_id),
                self._fetch_relevant_history(user_id, message),
                self._fetch_session(user_id),
            )
        )

        # contacts live inside user_info.contact_config — already fetched in profile
        contacts = profile.pop("contacts", [])

        context = {
            "profile":          profile,
            "contacts":         contacts,
            "entities":         entities,
            "thread_id":        thread_id,
            "recent_messages":  recent_messages,
            "relevant_history": relevant_history,
            "session":          session,
        }

        log.info(
            "rag.get_context.done",
            user_id=user_id,
            thread_id=thread_id,
            contacts_count=len(contacts),
            entities_count=len(entities),
            history_count=len(relevant_history),
            recent_count=len(recent_messages),
        )
        return context

    # ── PUBLIC METHOD 2: store ────────────────────────────────────────────────

    async def store(
        self,
        user_id: int,
        thread_id: str,
        message: str,
        intents: Any,
        entities: dict[str, Any],
        result: Any,
    ) -> None:
        """Persist this interaction after orchestrator finishes.

        Writes to:
          interactions  → saves this message turn with embedding
          user_entities → upserts any newly resolved aliases
          threads       → updates updated_at so thread stays active
          Redis         → updates session + thread message cache
        """
        log.info("rag.store.start", user_id=user_id, thread_id=thread_id)

        import asyncio
        await asyncio.gather(
            self._save_interaction(user_id, thread_id, message, intents, entities, result),
            self._upsert_entities(user_id, entities),
            self._touch_thread(thread_id),
            self._update_session(user_id, thread_id, intents, entities, result),
        )

        log.info("rag.store.done", user_id=user_id, thread_id=thread_id)

    # ── PRIVATE: thread management ────────────────────────────────────────────

    async def _resolve_thread(self, user_id: int, thread_id: str | None) -> str:
        """Return existing thread_id or create a new thread for this user.

        If thread_id is None  → new conversation, create new thread
        If thread_id provided → verify it belongs to this user, return it
        """
        if thread_id:
            async with self._pool.acquire() as conn:
                row = await conn.fetchrow(
                    """
                    SELECT thread_id FROM threads
                    WHERE  thread_id = $1 AND user_id = $2
                    """,
                    uuid.UUID(thread_id),
                    user_id,
                )
            if row:
                return thread_id
            log.warning("rag.thread.not_found", thread_id=thread_id, user_id=user_id)

        # create new thread
        new_id = str(uuid.uuid4())
        async with self._pool.acquire() as conn:
            await conn.execute(
                """
                INSERT INTO threads (thread_id, user_id)
                VALUES ($1, $2)
                """,
                uuid.UUID(new_id),
                user_id,
            )
        log.info("rag.thread.created", thread_id=new_id, user_id=user_id)
        return new_id

    async def _touch_thread(self, thread_id: str) -> None:
        """Update threads.updated_at to keep thread active."""
        try:
            async with self._pool.acquire() as conn:
                await conn.execute(
                    """
                    UPDATE threads SET updated_at = NOW()
                    WHERE  thread_id = $1
                    """,
                    uuid.UUID(thread_id),
                )
        except Exception as e:
            log.warning("rag.thread.touch_failed", thread_id=thread_id, error=str(e))

    # ── PRIVATE: fetch helpers ────────────────────────────────────────────────

    async def _fetch_profile(self, user_id: int) -> dict[str, Any]:
        """Fetch user profile + contacts from user_info table.

        user_info columns used:
          user_name      → display name
          phone_no       → user's phone
          status         → ACTIVE / INACTIVE
          contact_config → { userContactList: [ {userId, phoneNo, displayName} ] }
          ext_info       → { timezone, currency, language } — empty by default
        """
        async with self._pool.acquire() as conn:
            row = await conn.fetchrow(
                """
                SELECT user_name,
                       phone_no,
                       status,
                       contact_config,
                       ext_info
                FROM   user_info
                WHERE  user_id = $1
                """,
                user_id,
            )

        if row is None:
            return {
                "user_name": "User",
                "phone_no":  "",
                "status":    "ACTIVE",
                "contacts":  [],
                "timezone":  "UTC",
                "currency":  "SGD",
                "language":  "en",
            }

        # parse contact_config → flat contacts list
        contact_config = _parse_json(row["contact_config"]) or {}
        contacts = contact_config.get("userContactList", [])

        # parse ext_info → preferences (defaults if empty)
        ext_info = _parse_json(row["ext_info"]) or {}

        return {
            "user_name": row["user_name"] or "User",
            "phone_no":  row["phone_no"],
            "status":    row["status"],
            "contacts":  contacts,           # popped out in get_context()
            "timezone":  ext_info.get("timezone", "UTC"),
            "currency":  ext_info.get("currency", "SGD"),
            "language":  ext_info.get("language", "en"),
        }

    async def _fetch_entities(self, user_id: int) -> dict[str, Any]:
        """Fetch all learned entity aliases for this user.

        Returns:
          { "landlord": { name, walletId }, "rent": { amount: 500 } }
        """
        async with self._pool.acquire() as conn:
            rows = await conn.fetch(
                """
                SELECT key, value
                FROM   user_entities
                WHERE  user_id = $1
                """,
                user_id,
            )
        return {row["key"]: _parse_json(row["value"]) for row in rows}

    async def _fetch_recent_messages(
        self, thread_id: str, limit: int = 10
    ) -> list[dict[str, Any]]:
        """Fetch last N messages from this thread in order.

        Tries Redis cache first (fast), falls back to PostgreSQL.
        These are passed as messages[] to LLM so it remembers conversation.
        """
        # try Redis first
        try:
            raw = await self._redis.get(f"thread:{thread_id}:messages")
            if raw:
                messages = json.loads(raw)
                return messages[-limit:]
        except Exception:
            pass

        # fallback to PostgreSQL
        try:
            async with self._pool.acquire() as conn:
                rows = await conn.fetch(
                    """
                    SELECT role, message, created_at
                    FROM   interactions
                    WHERE  thread_id = $1
                    ORDER  BY created_at ASC
                    LIMIT  $2
                    """,
                    uuid.UUID(thread_id),
                    limit,
                )
            return [
                {
                    "role":       row["role"],
                    "content":    row["message"],
                    "created_at": str(row["created_at"]),
                }
                for row in rows
            ]
        except Exception as e:
            log.warning("rag.recent_messages.failed", thread_id=thread_id, error=str(e))
            return []

    async def _fetch_relevant_history(
        self, user_id: int, message: str
    ) -> list[dict[str, Any]]:
        """Semantic search — find past interactions most relevant to this message.

        Uses pgvector cosine similarity (<=>).
        Searches across ALL threads for this user — not just current thread.
        Falls back to empty list if embedding fails.
        """
        try:
            embedding = await self._embed(message)
            async with self._pool.acquire() as conn:
                rows = await conn.fetch(
                    """
                    SELECT message, intents, entities, result, created_at
                    FROM   interactions
                    WHERE  user_id    = $1
                      AND  role       = 'user'
                      AND  embedding  IS NOT NULL
                    ORDER  BY embedding <=> $2::vector
                    LIMIT  $3
                    """,
                    user_id,
                    embedding,
                    TOP_K_HISTORY,
                )
            return [
                {
                    "message":    row["message"],
                    "intents":    _parse_json(row["intents"]),
                    "entities":   _parse_json(row["entities"]),
                    "result":     _parse_json(row["result"]),
                    "created_at": str(row["created_at"]),
                }
                for row in rows
            ]
        except Exception as e:
            log.warning("rag.history.failed", user_id=user_id, error=str(e))
            return []

    async def _fetch_session(self, user_id: int) -> dict[str, Any]:
        """Fetch current session from Redis (last interaction, expires 1hr)."""
        try:
            raw = await self._redis.get(f"session:{user_id}")
            return json.loads(raw) if raw else {}
        except Exception as e:
            log.warning("rag.session.failed", user_id=user_id, error=str(e))
            return {}

    # ── PRIVATE: store helpers ────────────────────────────────────────────────

    async def _save_interaction(
        self,
        user_id: int,
        thread_id: str,
        message: str,
        intents: Any,
        entities: dict,
        result: Any,
    ) -> None:
        """Save two rows per conversation turn:
          role=user       → message + embedding (for future RAG search)
          role=assistant  → response text (for thread history display)
        """
        try:
            embedding = await self._embed(message)
            assistant_message = _extract_response_text(result)

            async with self._pool.acquire() as conn:
                # user message with embedding
                await conn.execute(
                    """
                    INSERT INTO interactions
                        (thread_id, user_id, role, message,
                         intents, entities, result, embedding)
                    VALUES
                        ($1, $2, 'user', $3,
                         $4::jsonb, $5::jsonb, $6::jsonb, $7::vector)
                    """,
                    uuid.UUID(thread_id),
                    user_id,
                    message,
                    json.dumps(_serialise(intents)),
                    json.dumps(entities),
                    json.dumps(_serialise(result)),
                    embedding,
                )

                # assistant response — no embedding needed
                await conn.execute(
                    """
                    INSERT INTO interactions
                        (thread_id, user_id, role, message,
                         intents, entities, result)
                    VALUES
                        ($1, $2, 'assistant', $3,
                         '{}', '{}', $4::jsonb)
                    """,
                    uuid.UUID(thread_id),
                    user_id,
                    assistant_message,
                    json.dumps(_serialise(result)),
                )

            # update Redis thread cache
            await self._append_to_thread_cache(
                thread_id, message, assistant_message
            )

        except Exception as e:
            # never crash the user response because memory write failed
            log.error("rag.interaction.save_failed", user_id=user_id, error=str(e))

    async def _upsert_entities(self, user_id: int, entities: dict[str, Any]) -> None:
        """Update learned aliases — INSERT or UPDATE if key already exists."""
        if not entities:
            return
        try:
            async with self._pool.acquire() as conn:
                for key, value in entities.items():
                    await conn.execute(
                        """
                        INSERT INTO user_entities (user_id, key, value, updated_at)
                        VALUES ($1, $2, $3::jsonb, NOW())
                        ON CONFLICT (user_id, key)
                        DO UPDATE SET value      = EXCLUDED.value,
                                      updated_at = NOW()
                        """,
                        user_id,
                        key,
                        json.dumps(value),
                    )
        except Exception as e:
            log.error("rag.entities.upsert_failed", user_id=user_id, error=str(e))

    async def _update_session(
        self,
        user_id: int,
        thread_id: str,
        intents: Any,
        entities: dict,
        result: Any,
    ) -> None:
        """Write latest interaction summary to Redis session cache."""
        try:
            await self._redis.set(
                f"session:{user_id}",
                json.dumps({
                    "thread_id": thread_id,
                    "intents":   _serialise(intents),
                    "entities":  entities,
                    "result":    _serialise(result),
                }),
                ex=SESSION_TTL,
            )
        except Exception as e:
            log.warning("rag.session.update_failed", user_id=user_id, error=str(e))

    async def _append_to_thread_cache(
        self, thread_id: str, user_message: str, assistant_message: str
    ) -> None:
        """Append both turns to Redis thread message cache."""
        try:
            key = f"thread:{thread_id}:messages"
            raw = await self._redis.get(key)
            messages = json.loads(raw) if raw else []
            messages.append({"role": "user",      "content": user_message})
            messages.append({"role": "assistant", "content": assistant_message})
            messages = messages[-20:]   # keep last 20 messages only
            await self._redis.set(key, json.dumps(messages), ex=SESSION_TTL)
        except Exception as e:
            log.warning("rag.thread_cache.failed", thread_id=thread_id, error=str(e))

    # ── PRIVATE: embedding ────────────────────────────────────────────────────

    async def _embed(self, text: str) -> list[float]:
        """Convert text into 1536-dim vector using OpenAI embeddings API."""
        response = await self._openai.embeddings.create(
            model=EMBEDDING_MODEL,
            input=text,
        )
        return response.data[0].embedding


# ── Utilities ─────────────────────────────────────────────────────────────────

def _parse_json(value: Any) -> Any:
    """Safely parse value that might be a JSON string or already a dict."""
    if isinstance(value, str):
        try:
            return json.loads(value)
        except Exception:
            return value
    return value or {}


def _serialise(obj: Any) -> Any:
    """Convert Pydantic models to plain dicts for JSON storage."""
    if obj is None:
        return {}
    if hasattr(obj, "model_dump"):
        return obj.model_dump()
    if hasattr(obj, "dict"):
        return obj.dict()
    if isinstance(obj, dict):
        return obj
    return str(obj)


def _extract_response_text(result: Any) -> str:
    """Pull the human-readable message out of the ChatResponse."""
    if hasattr(result, "message"):
        return str(result.message)
    if isinstance(result, dict):
        return str(result.get("message", result.get("response", "")))
    return str(result)